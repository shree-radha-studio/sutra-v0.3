        "selector": "JSXOpeningElement[name.name='PriceText'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|lead|currency|tbd|color|weight|style|key|ref|className|style|children)$/]",
        "message": "<PriceText> doesn't accept that prop. Declared props: value, size, lead, currency, tbd, color, weight, style."
