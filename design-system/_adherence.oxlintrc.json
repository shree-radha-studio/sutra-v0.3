        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|code|name|price|colours|activeColour|onColour|tag|tagTone|note|noteTone|stats|onAdd|onClick|selected|width|ratio|leadPrice|style|key|ref|className|style|children)$/]",
